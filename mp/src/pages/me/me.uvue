<template>
  <view class="flex flex-col px-16px py-24px flex-1">
    <!-- 粉丝 C 端会话 -->
    <view class="w-full bg-white rounded-12px px-20px py-24px mb-16px flex flex-col">
      <text class="text-16px font-bold text-[#1e293b] mb-12px">我的账号</text>
      <view class="flex flex-row items-center justify-between mb-8px">
        <text class="text-14px text-[#64748b]">粉丝身份</text>
        <text
          class="text-12px px-12px py-4px rounded-20px font-medium"
          :class="fanLoggedIn ? 'bg-[#d1fae5] text-[#065f46]' : 'bg-[#f1f5f9] text-[#64748b]'"
        >
          {{ fanLoggedIn ? '已连接' : '未连接' }}
        </text>
      </view>
      <text v-if="fanLoggedIn" class="text-13px text-[#64748b]" style="font-family: monospace;">openid: {{ maskedOpenid }}</text>
      <text v-if="fanLoggedIn && fanPoints >= 0" class="mt-8rpx text-14px text-[#0957DE] font-bold">积分余额：{{ fanPoints }}</text>
      <text v-else-if="!fanLoggedIn" class="text-13px text-[#94a3b8]">进入商城后将自动建立粉丝会话</text>
    </view>

    <!-- C 端菜单 -->
    <view class="w-full bg-white rounded-12px overflow-hidden mb-16px">
      <view class="px-20px h-56px flex flex-row items-center justify-between border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9]" @click="goShop">
        <text class="text-15px text-[#1e293b]">🛍️ 商城</text>
        <text class="text-12px text-[#94a3b8]">浏览商品 ›</text>
      </view>
      <view class="px-20px h-56px flex flex-row items-center justify-between border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9]" @click="goOrders">
        <text class="text-15px text-[#1e293b]">📦 我的订单</text>
        <text class="text-12px text-[#94a3b8]">查看全部 ›</text>
      </view>
      <view class="px-20px py-16rpx flex flex-row flex-wrap border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9]">
        <view
          v-for="item in orderShortcuts"
          :key="item.status"
          class="w-25p mb-12rpx items-center"
          @click="goOrdersStatus(item.status)"
        >
          <view class="relative">
            <text class="text-22px">{{ item.emoji }}</text>
            <view v-if="orderBadge(item.status) > 0" class="absolute px-8rpx py-2rpx rounded-20rpx" style="top: -8rpx; right: -16rpx; background-color: #ef4444; min-width: 28rpx;">
              <text class="text-10px text-[#ffffff] font-bold" style="text-align: center;">{{ orderBadge(item.status) }}</text>
            </view>
          </view>
          <text class="mt-6rpx text-11px text-[#64748b]">{{ item.label }}</text>
        </view>
      </view>
      <view class="px-20px h-56px flex flex-row items-center justify-between border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9]" @click="goCart">
        <text class="text-15px text-[#1e293b]">🛒 购物车</text>
        <view class="flex flex-row items-center">
          <text v-if="cartCount > 0" class="text-12px text-[#ef4444] font-bold mr-8rpx">{{ cartCount }}</text>
          <text class="text-12px text-[#94a3b8]">结算 ›</text>
        </view>
      </view>
      <view class="px-20px h-56px flex flex-row items-center justify-between border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9]" @click="goFavorites">
        <text class="text-15px text-[#1e293b]">❤️ 我的收藏</text>
        <text class="text-12px text-[#94a3b8]">查看 ›</text>
      </view>
      <view class="px-20px h-56px flex flex-row items-center justify-between border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9]" @click="goScene('/src/pages/scene/checkin')">
        <text class="text-15px text-[#1e293b]">📅 每日签到</text>
        <text class="text-12px text-[#94a3b8]">领积分 ›</text>
      </view>
      <view class="px-20px h-56px flex flex-row items-center justify-between border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9]" @click="goScene('/src/pages/scene/coupons')">
        <text class="text-15px text-[#1e293b]">🎫 优惠券</text>
        <text class="text-12px text-[#94a3b8]">领取 ›</text>
      </view>
      <view class="px-20px h-56px flex flex-row items-center justify-between border-bottom-width-1px border-bottom-style-solid border-bottom-color-[#f1f5f9]" @click="goScene('/src/pages/scene/distribution')">
        <text class="text-15px text-[#1e293b]">💰 分销加盟</text>
        <text class="text-12px text-[#94a3b8]">佣金 ›</text>
      </view>
      <view class="px-20px h-56px flex flex-row items-center justify-between border-top-width-1px border-top-style-solid border-top-color-[#f1f5f9]" @click="goAddresses">
        <text class="text-15px text-[#1e293b]">📍 收货地址</text>
        <text class="text-12px text-[#94a3b8]">管理 ›</text>
      </view>
    </view>

    <!-- 运营登录（折叠次要） -->
    <view class="w-full bg-white rounded-12px overflow-hidden">
      <view class="px-20px h-56px flex flex-row items-center justify-between" @click="adminCollapsed = !adminCollapsed">
        <text class="text-15px font-semibold text-[#64748b]">🔧 运营登录</text>
        <text class="text-12px text-[#94a3b8]">{{ adminCollapsed ? '展开 ▾' : '收起 ▴' }}</text>
      </view>
      <view v-if="!adminCollapsed" class="px-20px pb-20px flex flex-col">
        <view class="flex flex-col items-center py-16px mb-12px">
          <image class="w-64px h-64px rounded-32px mb-12px border-width-2px border-color-[#f1f5f9] border-solid" :src="avatarUrl" />
          <text class="text-16px font-bold text-[#1e293b] mb-4px">
            {{ userStore.state.userInfo.username.length > 0 ? userStore.state.userInfo.username : '未登录' }}
          </text>
          <text v-if="userStore.state.userInfo.nickname.length > 0" class="text-13px text-[#64748b] mb-8px">
            {{ userStore.state.userInfo.nickname }}
          </text>
          <text
            class="text-12px px-12px py-4px rounded-20px"
            :class="tokenStore.hasValidLogin() ? 'bg-[#d1fae5] text-[#065f46]' : 'bg-[#f1f5f9] text-[#64748b]'"
          >
            {{ tokenStore.hasValidLogin() ? '管理员已登录' : '管理员未登录' }}
          </text>
        </view>
        <view v-if="tokenStore.hasValidLogin()" class="w-full h-44px rounded-8px bg-[#ef4444] flex flex-row items-center justify-center" @click="handleLogout">
          <text class="text-[#ffffff] text-14px font-bold">退出登录</text>
        </view>
        <view v-else class="w-full h-44px rounded-8px bg-[#3b82f6] flex flex-row items-center justify-center" @click="handleLogin">
          <text class="text-[#ffffff] text-14px font-bold">管理员登录</text>
        </view>
      </view>
    </view>

    <!-- 开发演示折叠区 -->
    <view class="w-full bg-white rounded-12px mt-16px overflow-hidden">
      <view class="px-20px h-56px flex flex-row items-center justify-between" @click="demoCollapsed = !demoCollapsed">
        <text class="text-15px font-semibold text-[#334155]">🧪 开发演示</text>
        <text class="text-12px text-[#94a3b8]">{{ demoCollapsed ? '展开 ▾' : '收起 ▴' }}</text>
      </view>
      <view v-if="!demoCollapsed" class="px-20px pb-16px flex flex-col">
        <view class="h-48px rounded-8px bg-[#f8fafc] flex flex-row items-center px-16px mb-12px" @click="goDemo('/src/pages/basic/basic')">
          <text class="text-14px text-[#1e293b]">基础示例</text>
          <text class="flex-1 text-right text-12px text-[#94a3b8]">组件 / 主题 / 图表 ›</text>
        </view>
        <view class="h-48px rounded-8px bg-[#f8fafc] flex flex-row items-center px-16px" @click="goDemo('/src/pages/function/function')">
          <text class="text-14px text-[#1e293b]">功能示例</text>
          <text class="flex-1 text-right text-12px text-[#94a3b8]">系统信息 / 媒体 / 震动 ›</text>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { useTokenStore, useUserStore } from '../../store'
import { useShopSessionStore } from '../../store/shopSession'
import { getCachedShopOpenid, getShopOrderOverview } from '../../api/shop'
import { getFanProfile } from '../../api/app'
import { getCartItemCount } from '../../utils/cartBadge'
import { ZWEQ_ACCOUNT_ID } from '../../config/zweq'
import type { IShopOrderOverview } from '../../api/shop'
import { LOGIN_PAGE } from '../../router/config'
import { handleBackPressExit } from '@/src/utils/backPress'
import { setCurIdxByPath } from '@/src/tabbar/store'

onBackPress((options: OnBackPressOptions): boolean => {
  // #ifdef APP
  if (options.from == 'backbutton') {
    return handleBackPressExit()
  }
  // #endif
  return false
})

const userStore = useUserStore()
const tokenStore = useTokenStore()
const shopSession = useShopSessionStore()

const adminCollapsed = ref<boolean>(true)
const demoCollapsed = ref<boolean>(true)
const fanLoggedIn = ref<boolean>(false)
const maskedOpenid = ref<string>('')
const fanPoints = ref<number>(-1)
const cartCount = ref<number>(0)
const orderOverview = ref<IShopOrderOverview | null>(null)

type IOrderShortcut = {
  label: string
  emoji: string
  status: number
}

const orderShortcuts: IOrderShortcut[] = [
  { label: '待支付', emoji: '💳', status: 0 },
  { label: '待发货', emoji: '📮', status: 1 },
  { label: '待收货', emoji: '🚚', status: 2 },
  { label: '已完成', emoji: '✅', status: 3 },
]

const avatarUrl = computed((): string => {
  if (userStore.state.userInfo.avatar.length > 0) {
    return userStore.state.userInfo.avatar
  }
  return '/static/logo.png'
})

function maskOpenid(openid: string): string {
  if (openid.length <= 8) return openid
  const head = openid.substring(0, 4)
  const tail = openid.substring(openid.length - 4)
  return `${head}****${tail}`
}

function refreshFanSession() {
  const openid = getCachedShopOpenid(ZWEQ_ACCOUNT_ID)
  fanLoggedIn.value = shopSession.isValid(ZWEQ_ACCOUNT_ID) && openid.length > 0
  maskedOpenid.value = openid.length > 0 ? maskOpenid(openid) : ''
  if (fanLoggedIn.value) {
    getFanProfile(ZWEQ_ACCOUNT_ID)
      .then((profile) => {
        fanPoints.value = profile.points
      })
      .catch(() => {
        fanPoints.value = -1
      })
    getCartItemCount(ZWEQ_ACCOUNT_ID)
      .then((count: number) => {
        cartCount.value = count
      })
      .catch(() => {
        cartCount.value = 0
      })
    getShopOrderOverview(ZWEQ_ACCOUNT_ID)
      .then((overview: IShopOrderOverview) => {
        orderOverview.value = overview
      })
      .catch(() => {
        orderOverview.value = null
      })
  } else {
    fanPoints.value = -1
    cartCount.value = 0
    orderOverview.value = null
  }
}

onShow(() => {
  refreshFanSession()
})

function goShop() {
  uni.navigateTo({ url: '/src/pages/shop/products' })
}

function goOrders() {
  uni.navigateTo({ url: '/src/pages/shop/orders' })
}

function goOrdersStatus(status: number) {
  uni.navigateTo({ url: `/src/pages/shop/orders?status=${status}` })
}

function orderBadge(status: number): number {
  if (orderOverview.value == null) {
    return 0
  }
  const o = orderOverview.value!
  switch (status) {
    case 0: return o.pending_pay
    case 1: return o.pending_ship
    case 2: return o.shipped
    case 3: return o.completed
    default: return 0
  }
}

function goCart() {
  uni.navigateTo({ url: '/src/pages/shop/cart' })
}

function goFavorites() {
  uni.navigateTo({ url: '/src/pages/shop/favorites' })
}

function goScene(url: string) {
  uni.navigateTo({ url })
}

function goAddresses() {
  uni.navigateTo({ url: '/src/pages/shop/addresses' })
}

function handleLogin() {
  uni.navigateTo({ url: LOGIN_PAGE })
}

function goDemo(url: string) {
  uni.navigateTo({ url })
}

function handleLogout() {
  uni.showModal({
    title: '提示',
    content: '确定要退出登录吗？',
    success: (res) => {
      if (res.confirm) {
        tokenStore.clearToken()
        userStore.clearUserInfo()
        uni.showToast({
          title: '退出登录成功',
          icon: 'success',
        })
        setTimeout(() => {
          const targetUrl = '/src/pages/index/index'
          setCurIdxByPath(targetUrl)
          uni.switchTab({ url: targetUrl })
        }, 0)
      }
    },
  })
}
</script>

<style scoped lang="scss">
</style>
