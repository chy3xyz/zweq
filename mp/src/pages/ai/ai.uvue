<template>
  <view class="page-root">
    <!-- 自定义导航栏（AI 为 tab 页，无返回） -->
    <NavBar title="AI 智能助手" :show-back="false" />

    <!-- 消息滚动区 -->
    <scroll-view
      class="flex-1 px-15px py-10px"
      scroll-y="true"
      :scroll-top="scrollTop"
      :scroll-with-animation="true"
    >
      <view v-for="msg in messages" :key="msg.id" class="mb-15px flex-col">
        <!-- AI 消息 -->
        <view v-if="isAiMessage(msg.sender)" class="msg-row-start">
          <view class="w-36px h-36px rounded-18px bg-[#2563eb] items-center justify-center mr-10px shadow-sm">
            <text class="text-white text-12px font-bold">AI</text>
          </view>
          <view class="msg-content-left">
            <view class="bg-white p-12px rounded-r-16px rounded-bl-16px shadow-sm border border-[#e2e8f0]">
              <text class="text-[#1e293b] text-14px leading-relaxed">{{ msg.content }}</text>
            </view>
            <text class="text-[#94a3b8] text-10px mt-4px ml-4px">{{ msg.time }}</text>
          </view>
        </view>

        <!-- 用户消息 -->
        <view v-else class="msg-row-end">
          <view class="msg-content-right">
            <view class="bg-[#10b981] p-12px rounded-l-16px rounded-br-16px shadow-sm">
              <text class="text-white text-14px leading-relaxed">{{ msg.content }}</text>
            </view>
            <text class="text-[#94a3b8] text-10px mt-4px mr-4px">{{ msg.time }}</text>
          </view>
          <view class="w-36px h-36px rounded-18px bg-[#e2e8f0] items-center justify-center ml-10px shadow-sm">
            <text class="text-[#64748b] text-12px font-bold">ME</text>
          </view>
        </view>
      </view>

      <!-- AI 正在输入状态 -->
      <view v-if="isTyping" class="msg-row-start mb-15px">
        <view class="w-36px h-36px rounded-18px bg-[#2563eb] items-center justify-center mr-10px shadow-sm">
          <text class="text-white text-12px font-bold">AI</text>
        </view>
        <view class="bg-white p-12px rounded-r-16px rounded-bl-16px shadow-sm border border-[#e2e8f0]">
          <text class="text-[#64748b] text-14px">AI 正在思考中...</text>
        </view>
      </view>

      <!-- 底部安全间距占位（加上底部输入框的高度避免遮挡） -->
      <view :style="{ height: `${safeAreaBottom + 70}px` }" />
    </scroll-view>

    <!-- 底部输入框区 -->
    <view class="footer-fixed bg-white border-t border-[#e2e8f0] p-10px flex-col" :style="{ paddingBottom: `${safeAreaBottom + 10}px` }">
      <view class="flex-row items-center bg-[#f1f5f9] rounded-24px px-12px py-6px">
        <input
          v-model="inputText"
          type="text"
          placeholder="和 AI 助手聊点什么吧..."
          placeholder-style="color: #94a3b8"
          class="chat-input"
          confirm-type="send"
          @confirm="sendMessage"
        />
        <view class="w-32px h-32px rounded-16px bg-[#2563eb] items-center justify-center ml-8px" @click="sendMessage">
          <uni-icons type="paperplane-filled" size="18" color="#ffffff"></uni-icons>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
/* eslint-disable ts/consistent-type-definitions */
import NavBar from '@/src/components/NavBar/NavBar.uvue'
import { shopAssistant } from '@/src/api/ai'
import { ZWEQ_ACCOUNT_ID } from '@/src/config/zweq'
import { safeAreaInsets } from '@/src/utils/systemInfo'

type ChatMessage = {
  id: string
  sender: string
  content: string
  time: string
}

const messages = ref<ChatMessage[]>([])
const inputText = ref<string>('')
const isTyping = ref<boolean>(false)
const scrollTop = ref<number>(0)

// 判断是否为 AI 消息
function isAiMessage(sender: string): boolean {
  return sender == 'ai'
}

// 底部安全区
const safeAreaBottom = computed<number>((): number => {
  const insets = safeAreaInsets.value
  if (insets != null) {
    return insets.bottom
  }
  return 0
})

// 获取当前时间字符串
function getCurrentTime(): string {
  const date = new Date()
  const hours = date.getHours() as number
  const minutes = date.getMinutes() as number
  const hStr = hours < 10 ? `0${hours}` : `${hours}`
  const mStr = minutes < 10 ? `0${minutes}` : `${minutes}`
  return `${hStr}:${mStr}`
}

// 自动滚动到底部
function scrollToBottom() {
  setTimeout(() => {
    scrollTop.value = scrollTop.value + 1000
  }, 100)
}

function extractApiErrorMessage(err: any): string {
  if (err != null) {
    const errObj = err as UTSJSONObject
    const message = errObj['message'] as string | null
    if (message != null && message.length > 0) {
      const colonIdx = message.indexOf('：')
      if (colonIdx >= 0 && colonIdx < message.length - 1) {
        return message.substring(colonIdx + 1)
      }
      return message
    }
    const msg = errObj['msg'] as string | null
    if (msg != null && msg.length > 0) {
      return msg
    }
  }
  return '请求失败，请稍后再试'
}

// 发送消息
async function sendMessage() {
  const text = inputText.value.trim()
  if (text == '' || isTyping.value) {
    return
  }

  messages.value.push({
    id: Date.now().toString(),
    sender: 'user',
    content: text,
    time: getCurrentTime(),
  } as ChatMessage)

  inputText.value = ''
  scrollToBottom()

  isTyping.value = true

  try {
    const result = await shopAssistant(ZWEQ_ACCOUNT_ID, text)
    messages.value.push({
      id: Date.now().toString(),
      sender: 'ai',
      content: result.reply,
      time: getCurrentTime(),
    } as ChatMessage)
    scrollToBottom()
  }
  catch (err) {
    uni.showToast({ title: extractApiErrorMessage(err), icon: 'none' })
  }
  finally {
    isTyping.value = false
  }
}

onMounted(() => {
  // 欢迎语
  messages.value.push({
    id: 'welcome',
    sender: 'ai',
    content: '你好！我是你的 AI 智能助手。你可以询问我任何关于本应用的问题，或者只是和我随便聊聊！✨',
    time: getCurrentTime(),
  } as ChatMessage)
})
</script>

