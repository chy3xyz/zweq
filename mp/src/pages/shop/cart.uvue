<template>
  <view>
    <NavBar title="购物车" :show-back="true" />
    <view class="content-container pb-120rpx">
      <view class="mx-30rpx mt-16rpx px-24rpx py-16rpx rounded-12px flex flex-row items-center justify-between" style="background-color: rgba(9, 87, 222, 0.06);" @click="goAddresses">
        <text class="text-13px text-[#0957DE]">📍 管理收货地址</text>
        <text class="text-12px text-[#64748b]">›</text>
      </view>

      <view v-if="displayRows.length > 0" class="mx-30rpx mt-16rpx flex flex-row items-center" @click="toggleSelectAll">
        <view class="w-36rpx h-36rpx rounded-full mr-12rpx flex flex-row items-center justify-center" :style="selectAllStyle">
          <view v-if="allSelected" class="w-16rpx h-16rpx rounded-full" style="background-color: #ffffff;" />
        </view>
        <text class="text-13px text-[#64748b]">全选</text>
      </view>

      <view v-for="row in displayRows" :key="row.id" class="mx-30rpx mt-20rpx px-24rpx py-20rpx rounded-12px" style="background-color: #f8fafc;">
        <view class="flex flex-row items-start">
          <view class="w-36rpx h-36rpx rounded-full mr-16rpx mt-40rpx flex flex-row items-center justify-center" :style="rowSelectStyle(row.id)" @click="toggleSelect(row.id)">
            <view v-if="isSelected(row.id)" class="w-16rpx h-16rpx rounded-full" style="background-color: #ffffff;" />
          </view>
          <view class="flex-1 flex flex-row">
            <image v-if="row.line.image !== ''" class="w-120rpx h-120rpx rounded-8rpx mr-16rpx" :src="row.line.image" mode="aspectFill" />
            <view v-else class="w-120rpx h-120rpx rounded-8rpx mr-16rpx items-center justify-center" style="background-color: #e2e8f0;">
              <text class="text-12px text-[#94a3b8]">无图</text>
            </view>
            <view class="flex-1">
              <text class="text-14px font-bold text-[#1e293b]">{{ row.line.product_name }}</text>
              <text v-if="row.line.spec_text !== ''" class="mt-6rpx block text-12px text-[#94a3b8]">{{ row.line.spec_text }}</text>
              <view class="mt-12rpx flex flex-row items-center justify-between">
                <text class="text-15px font-bold text-[#ef4444]">¥{{ fenToYuan(row.line.price) }}</text>
                <view class="flex flex-row items-center">
                  <view class="w-48rpx h-48rpx rounded-8rpx items-center justify-center" style="background-color: #e2e8f0;" @click="changeQty(row, -1)">
                    <text class="text-16px font-bold text-[#64748b]">-</text>
                  </view>
                  <text class="mx-16rpx text-14px font-bold">{{ row.line.quantity }}</text>
                  <view class="w-48rpx h-48rpx rounded-8rpx items-center justify-center" style="background-color: #e2e8f0;" @click="changeQty(row, 1)">
                    <text class="text-16px font-bold text-[#64748b]">+</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
        <view class="mt-16rpx flex flex-row justify-end">
          <view class="px-16rpx py-6rpx rounded-8rpx" style="background-color: #fee2e2;" @click="del(row.id)">
            <text class="text-12px text-[#ef4444]">删除</text>
          </view>
        </view>
      </view>

      <view v-if="displayRows.length === 0 && !loading" class="mt-60rpx items-center">
        <text class="text-14px text-[#94a3b8]">购物车空空如也，去逛逛吧</text>
        <view class="mt-20rpx px-32rpx py-12rpx rounded-8rpx" style="background-color: #0957DE;" @click="goProducts">
          <text class="text-13px text-[#ffffff]">去逛逛</text>
        </view>
      </view>
    </view>

    <view v-if="displayRows.length > 0" class="fixed bottom-0 left-0 right-0 px-30rpx py-20rpx flex flex-row items-center justify-between" style="background-color: #ffffff; border-top-width: 1px; border-top-color: #e2e8f0; border-top-style: solid;">
      <view>
        <text class="text-12px text-[#64748b]">合计</text>
        <text class="text-18px font-bold text-[#ef4444]"> ¥{{ fenToYuan(selectedTotal) }}</text>
      </view>
      <view class="px-40rpx py-20rpx rounded-12rpx" :style="{ backgroundColor: selectedCount > 0 ? '#0957DE' : '#cbd5e1' }" @click="checkout">
        <text class="text-15px font-bold text-[#ffffff]">结算（{{ selectedCount }}）</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { listShopCart, deleteShopCart, updateShopCart } from '../../api/shop'
import { ZWEQ_ACCOUNT_ID } from '../../config/zweq'
import { fenToYuan } from '../../utils/format'
import { enrichShopLineItems, sumLineItems } from '../../utils/shopDisplay'
import type { IShopCartItem } from '../../api/shop'
import type { IShopLineItem } from '../../utils/shopDisplay'

type ICartDisplayRow = {
  id: number
  line: IShopLineItem
}

const displayRows = ref<ICartDisplayRow[]>([])
const selectedIds = ref<number[]>([])
const loading = ref<boolean>(false)
const updatingId = ref<number>(0)

const selectedCount = computed<number>(() => selectedIds.value.length)

const allSelected = computed<boolean>(() => {
  if (displayRows.value.length === 0) {
    return false
  }
  return selectedIds.value.length === displayRows.value.length
})

const selectAllStyle = computed<UTSJSONObject>(() => {
  if (allSelected.value) {
    return { backgroundColor: '#0957DE', borderWidth: '1px', borderColor: '#0957DE', borderStyle: 'solid' } as UTSJSONObject
  }
  return { backgroundColor: '#ffffff', borderWidth: '1px', borderColor: '#cbd5e1', borderStyle: 'solid' } as UTSJSONObject
})

const selectedTotal = computed<number>(() => {
  const lines: IShopLineItem[] = []
  for (let i = 0; i < displayRows.value.length; i++) {
    const row = displayRows.value[i]
    if (isSelected(row.id)) {
      lines.push(row.line)
    }
  }
  return sumLineItems(lines)
})

onLoad(() => {
  load()
})

onShow(() => {
  load()
})

onPullDownRefresh(() => {
  load()
  setTimeout(() => {
    uni.stopPullDownRefresh()
  }, 400)
})

function isSelected(id: number): boolean {
  for (let i = 0; i < selectedIds.value.length; i++) {
    if (selectedIds.value[i] === id) {
      return true
    }
  }
  return false
}

function rowSelectStyle(id: number): UTSJSONObject {
  if (isSelected(id)) {
    return { backgroundColor: '#0957DE', borderWidth: '1px', borderColor: '#0957DE', borderStyle: 'solid' } as UTSJSONObject
  }
  return { backgroundColor: '#ffffff', borderWidth: '1px', borderColor: '#cbd5e1', borderStyle: 'solid' } as UTSJSONObject
}

function toggleSelect(id: number) {
  const next: number[] = []
  let found = false
  for (let i = 0; i < selectedIds.value.length; i++) {
    if (selectedIds.value[i] === id) {
      found = true
    } else {
      next.push(selectedIds.value[i])
    }
  }
  if (!found) {
    next.push(id)
  }
  selectedIds.value = next
}

function toggleSelectAll() {
  if (allSelected.value) {
    selectedIds.value = []
    return
  }
  const next: number[] = []
  for (let i = 0; i < displayRows.value.length; i++) {
    next.push(displayRows.value[i].id)
  }
  selectedIds.value = next
}

function syncSelectionAfterLoad(rows: ICartDisplayRow[]) {
  if (rows.length === 0) {
    selectedIds.value = []
    return
  }
  const valid: number[] = []
  for (let i = 0; i < selectedIds.value.length; i++) {
    const id = selectedIds.value[i]
    for (let j = 0; j < rows.length; j++) {
      if (rows[j].id === id) {
        valid.push(id)
        break
      }
    }
  }
  if (valid.length === 0) {
    const all: number[] = []
    for (let i = 0; i < rows.length; i++) {
      all.push(rows[i].id)
    }
    selectedIds.value = all
    return
  }
  selectedIds.value = valid
}

function load() {
  loading.value = true
  listShopCart(ZWEQ_ACCOUNT_ID)
    .then(async (carts: IShopCartItem[]) => {
      if (carts.length === 0) {
        displayRows.value = []
        selectedIds.value = []
        return
      }
      const items: { product_id: number; sku_id: number; quantity: number }[] = []
      for (let i = 0; i < carts.length; i++) {
        const c = carts[i]
        items.push({
          product_id: c.product_id,
          sku_id: c.sku_id,
          quantity: c.quantity,
        })
      }
      const lines = await enrichShopLineItems(items)
      const rows: ICartDisplayRow[] = []
      for (let i = 0; i < carts.length; i++) {
        rows.push({
          id: carts[i].id,
          line: lines[i],
        })
      }
      displayRows.value = rows
      syncSelectionAfterLoad(rows)
    })
    .catch(() => {
      displayRows.value = []
      selectedIds.value = []
    })
    .finally(() => {
      loading.value = false
    })
}

function changeQty(row: ICartDisplayRow, delta: number) {
  if (updatingId.value > 0) return
  const nextQty = row.line.quantity + delta
  if (nextQty < 1) return
  updatingId.value = row.id
  updateShopCart(row.id, nextQty)
    .then(() => {
      load()
    })
    .catch(() => {
      uni.showToast({ title: '更新失败', icon: 'none' })
    })
    .finally(() => {
      updatingId.value = 0
    })
}

function goAddresses() {
  uni.navigateTo({ url: '/src/pages/shop/addresses' })
}

function goProducts() {
  uni.navigateTo({ url: '/src/pages/shop/products' })
}

function del(id: number) {
  deleteShopCart(id)
    .then(() => {
      load()
    })
    .catch(() => {
      uni.showToast({ title: '删除失败', icon: 'none' })
    })
}

function checkout() {
  if (selectedIds.value.length === 0) {
    uni.showToast({ title: '请选择要结算的商品', icon: 'none' })
    return
  }
  const ids = selectedIds.value.join(',')
  uni.navigateTo({ url: `/src/pages/shop/checkout?cart_ids=${ids}` })
}
</script>
