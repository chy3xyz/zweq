<template>
  <view>
    <NavBar title="商品详情" :show-back="true" />
    <view class="content-container pb-20px">
      <view v-if="product != null" class="px-30rpx pt-20rpx">
        <image v-if="product.image !== ''" class="w-full h-420rpx rounded-12px" :src="product.image" mode="aspectFill" />
        <view v-else class="w-full h-420rpx rounded-12px items-center justify-center" style="background-color: #e2e8f0;">
          <text class="text-14px text-[#94a3b8]">无图</text>
        </view>

        <view class="mt-20rpx flex flex-row items-end">
          <text class="text-32px font-bold text-[#ef4444]">¥{{ fenToYuan(price) }}</text>
          <text class="ml-12rpx text-12px text-[#94a3b8] line-through">¥{{ fenToYuan(product.original_price) }}</text>
        </view>
        <text class="mt-12rpx block text-18px font-bold text-[#1e293b]">{{ product.name }}</text>
        <text class="mt-8rpx block text-13px text-[#64748b]">{{ product.content }}</text>
        <text class="mt-8rpx block text-12px text-[#94a3b8]">库存 {{ stock }} · 已售 {{ product.sales }}</text>

        <!-- 数量 -->
        <view class="mt-30rpx flex flex-row items-center justify-between px-24rpx py-20rpx rounded-12px" style="background-color: #f8fafc;">
          <text class="text-14px text-[#1e293b]">购买数量</text>
          <view class="flex flex-row items-center">
            <view class="w-56rpx h-56rpx rounded-8rpx items-center justify-center" style="background-color: #e2e8f0;" @click="qty > 1 && (qty--)">
              <text class="text-18px font-bold text-[#64748b]">-</text>
            </view>
            <text class="mx-24rpx text-16px font-bold">{{ qty }}</text>
            <view class="w-56rpx h-56rpx rounded-8rpx items-center justify-center" style="background-color: #e2e8f0;" @click="qty < stock && (qty++)">
              <text class="text-18px font-bold text-[#64748b]">+</text>
            </view>
          </view>
        </view>

        <!-- 操作 -->
        <view class="mt-40rpx flex flex-row">
          <view class="w-88rpx h-88rpx rounded-12rpx items-center justify-center mr-16rpx" :style="{ backgroundColor: faved ? '#fef2f2' : '#f1f5f9' }" @click="toggleFav">
            <text :style="{ color: faved ? '#ef4444' : '#94a3b8' }" class="text-28rpx">{{ faved ? '♥' : '♡' }}</text>
          </view>
          <button class="flex-1 h-88rpx rounded-12rpx text-[#ffffff] text-15px font-bold mr-16rpx" :style="{ backgroundColor: '#f59e0b' }" @click="buyNow">
            立即购买
          </button>
          <button class="flex-1 h-88rpx rounded-12rpx text-[#ffffff] text-15px font-bold" :style="{ backgroundColor: '#0957DE' }" @click="addCart">
            加入购物车
          </button>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import { getShopProduct, addShopCart, createShopAddress, createShopOrder } from '../../api/shop'
import { fenToYuan } from '../../utils/format'
import type { IShopProduct, IShopSku } from '../../api/shop'

const product = ref<IShopProduct | null>(null)
const sku = ref<IShopSku | null>(null)
const qty = ref<number>(1)
const faved = ref<boolean>(false)

const price = computed<number>(() => (sku.value != null ? sku.value.price : (product.value != null ? product.value.price : 0)))
const stock = computed<number>(() => (sku.value != null ? sku.value.stock : (product.value != null ? product.value.stock : 0)))

onLoad((options: UTSJSONObject | null) => {
  if (options != null) {
    const id = options['id'] as number | null
    if (id != null) {
      load(id)
    }
  }
})

function load(id: number) {
  getShopProduct(id)
    .then((res: any) => {
      const detail = res as UTSJSONObject
      product.value = detail['product'] as IShopProduct
      const skus = detail['skus'] as IShopSku[]
      if (skus.length > 0) {
        sku.value = skus[0]
      }
    })
    .catch(() => {
      uni.showToast({ title: '商品不存在', icon: 'none' })
    })
}

function toggleFav() {
  if (product.value == null) return
  if (faved.value) {
    uni.showToast({ title: '已收藏', icon: 'none' })
    return
  }
  addShopFavorite(product.value.account_id, product.value.id)
    .then(() => {
      faved.value = true
      uni.showToast({ title: '收藏成功', icon: 'success' })
    })
    .catch(() => {
      uni.showToast({ title: '收藏失败', icon: 'none' })
    })
}

function addCart() {
  if (product.value == null || sku.value == null) return
  addShopCart(product.value.account_id, product.value.id, sku.value.id, qty.value)
    .then(() => {
      uni.showToast({ title: '已加入购物车', icon: 'success' })
    })
    .catch(() => {
      uni.showToast({ title: '加入失败', icon: 'none' })
    })
}

function buyNow() {
  if (product.value == null || sku.value == null) return
  // H5 演示：自动创建默认地址并下单（mock 支付）
  createShopAddress(product.value.account_id, '演示用户', '13800138000', '广东省深圳市', '科技园 1 号')
    .then((addr: any) => {
      const addressId = (addr as UTSJSONObject)['id'] as number
      return createShopOrder(product.value.account_id, addressId, [{
        product_id: product.value!.id,
        sku_id: sku.value!.id,
        quantity: qty.value,
      }])
    })
    .then((order: any) => {
      const orderId = (order as UTSJSONObject)['id'] as number
      uni.showToast({ title: '下单成功', icon: 'success' })
      setTimeout(() => {
        uni.redirectTo({ url: `/src/pages/shop/orders?highlight=${orderId}` })
      }, 400)
    })
    .catch(() => {
      uni.showToast({ title: '下单失败，库存不足？', icon: 'none' })
    })
}
</script>
