<template>
  <view>
    <NavBar title="收货地址" :show-back="true" />
    <view class="content-container pb-20px">
      <view v-for="addr in addresses" :key="addr.id" class="mx-30rpx mt-20rpx px-24rpx py-20rpx rounded-12px" style="background-color: #f8fafc;">
        <view class="flex flex-row items-center justify-between">
          <view class="flex flex-row items-center">
            <text class="text-15px font-bold text-[#1e293b]">{{ addr.name }}</text>
            <text v-if="addr.is_default === 1" class="ml-12rpx text-10px px-8rpx py-2rpx rounded-4rpx text-[#0957DE]" style="background-color: rgba(9, 87, 222, 0.1);">默认</text>
          </view>
          <text class="text-14px text-[#64748b]">{{ addr.mobile }}</text>
        </view>
        <text class="mt-12rpx block text-13px text-[#64748b]">{{ addr.region }} {{ addr.detail }}</text>
        <view class="mt-16rpx flex flex-row justify-end">
          <view class="px-20rpx py-8rpx rounded-8rpx mr-12rpx" style="background-color: #e2e8f0;" @click="startEdit(addr)">
            <text class="text-12px text-[#0957DE]">编辑</text>
          </view>
          <view v-if="addr.is_default !== 1" class="px-20rpx py-8rpx rounded-8rpx mr-12rpx" style="background-color: #e2e8f0;" @click="setDefault(addr.id)">
            <text class="text-12px text-[#0957DE]">设为默认</text>
          </view>
          <view class="px-20rpx py-8rpx rounded-8rpx" style="background-color: #fee2e2;" @click="remove(addr.id)">
            <text class="text-12px text-[#ef4444]">删除</text>
          </view>
        </view>
      </view>

      <view v-if="addresses.length === 0 && !loading" class="mt-60rpx items-center">
        <text class="text-14px text-[#94a3b8]">暂无收货地址</text>
      </view>

      <!-- 新增/编辑表单 -->
      <view class="mx-30rpx mt-30rpx px-24rpx py-24rpx rounded-12px" style="background-color: #ffffff; border-width: 1px; border-color: #e2e8f0; border-style: solid;">
        <text class="text-15px font-bold text-[#1e293b] mb-16rpx">{{ editingId > 0 ? '编辑地址' : '新增地址' }}</text>
        <view class="mb-16rpx">
          <text class="text-12px text-[#64748b] mb-8rpx">收货人</text>
          <input v-model="formName" class="h-72rpx px-16rpx rounded-8rpx text-14px" style="background-color: #f8fafc;" placeholder="姓名" />
        </view>
        <view class="mb-16rpx">
          <text class="text-12px text-[#64748b] mb-8rpx">手机号</text>
          <input v-model="formMobile" class="h-72rpx px-16rpx rounded-8rpx text-14px" style="background-color: #f8fafc;" placeholder="11 位手机号" />
        </view>
        <view class="mb-16rpx">
          <text class="text-12px text-[#64748b] mb-8rpx">省市区</text>
          <input v-model="formRegion" class="h-72rpx px-16rpx rounded-8rpx text-14px" style="background-color: #f8fafc;" placeholder="如：广东省深圳市南山区" />
        </view>
        <view class="mb-20rpx">
          <text class="text-12px text-[#64748b] mb-8rpx">详细地址</text>
          <input v-model="formDetail" class="h-72rpx px-16rpx rounded-8rpx text-14px" style="background-color: #f8fafc;" placeholder="街道门牌号" />
        </view>
        <view v-if="editingId > 0" class="mb-20rpx flex flex-row items-center" @click="formIsDefault = !formIsDefault">
          <view class="w-36rpx h-36rpx rounded-8rpx mr-12rpx flex flex-row items-center justify-center" :style="defaultCheckStyle">
            <text v-if="formIsDefault" class="text-12px text-[#ffffff]">✓</text>
          </view>
          <text class="text-13px text-[#64748b]">设为默认地址</text>
        </view>
        <view class="flex flex-row">
          <view v-if="editingId > 0" class="flex-1 mr-16rpx h-80rpx rounded-12rpx flex flex-row items-center justify-center" style="background-color: #e2e8f0;" @click="cancelEdit">
            <text class="text-14px text-[#64748b]">取消</text>
          </view>
          <view class="flex-1 h-80rpx rounded-12rpx flex flex-row items-center justify-center" style="background-color: #0957DE;" @click="submit">
            <text class="text-14px font-bold text-[#ffffff]">{{ editingId > 0 ? '保存修改' : '保存地址' }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref } from 'vue'
import {
  listShopAddresses,
  createShopAddress,
  updateShopAddress,
  deleteShopAddress,
  setShopAddressDefault,
} from '../../api/shop'
import { ZWEQ_ACCOUNT_ID } from '../../config/zweq'
import type { IShopAddress } from '../../api/shop'

const addresses = ref<IShopAddress[]>([])
const loading = ref<boolean>(false)
const editingId = ref<number>(0)
const formName = ref<string>('')
const formMobile = ref<string>('')
const formRegion = ref<string>('')
const formDetail = ref<string>('')
const formIsDefault = ref<boolean>(false)

const defaultCheckStyle = computed<UTSJSONObject>(() => {
  if (formIsDefault.value) {
    return { backgroundColor: '#0957DE', borderWidth: '1px', borderColor: '#0957DE', borderStyle: 'solid' } as UTSJSONObject
  }
  return { backgroundColor: '#ffffff', borderWidth: '1px', borderColor: '#cbd5e1', borderStyle: 'solid' } as UTSJSONObject
})

onLoad(() => {
  load()
})

onShow(() => {
  load()
})

function load() {
  loading.value = true
  listShopAddresses(ZWEQ_ACCOUNT_ID)
    .then((res: any) => {
      addresses.value = res as IShopAddress[]
    })
    .catch(() => {
      addresses.value = []
    })
    .finally(() => {
      loading.value = false
    })
}

function startEdit(addr: IShopAddress) {
  editingId.value = addr.id
  formName.value = addr.name
  formMobile.value = addr.mobile
  formRegion.value = addr.region
  formDetail.value = addr.detail
  formIsDefault.value = addr.is_default === 1
}

function cancelEdit() {
  editingId.value = 0
  formName.value = ''
  formMobile.value = ''
  formRegion.value = ''
  formDetail.value = ''
  formIsDefault.value = false
}

function setDefault(id: number) {
  setShopAddressDefault(id)
    .then(() => {
      uni.showToast({ title: '已设为默认', icon: 'success' })
      load()
    })
    .catch(() => {
      uni.showToast({ title: '操作失败', icon: 'none' })
    })
}

function remove(id: number) {
  uni.showModal({
    title: '提示',
    content: '确定删除该地址吗？',
    success: (res) => {
      if (res.confirm) {
        deleteShopAddress(id)
          .then(() => {
            if (editingId.value === id) {
              cancelEdit()
            }
            uni.showToast({ title: '已删除', icon: 'success' })
            load()
          })
          .catch(() => {
            uni.showToast({ title: '删除失败', icon: 'none' })
          })
      }
    },
  })
}

function isValidMobile(mobile: string): boolean {
  if (mobile.length !== 11) {
    return false
  }
  return mobile.startsWith('1')
}

function submit() {
  if (formName.value.trim().length === 0 || formMobile.value.trim().length === 0) {
    uni.showToast({ title: '请填写姓名和手机号', icon: 'none' })
    return
  }
  const mobile = formMobile.value.trim()
  if (!isValidMobile(mobile)) {
    uni.showToast({ title: '请输入 11 位手机号', icon: 'none' })
    return
  }
  if (formRegion.value.trim().length === 0 || formDetail.value.trim().length === 0) {
    uni.showToast({ title: '请填写完整地址', icon: 'none' })
    return
  }

  if (editingId.value > 0) {
    updateShopAddress(
      editingId.value,
      formName.value.trim(),
      mobile,
      formRegion.value.trim(),
      formDetail.value.trim(),
      formIsDefault.value,
    )
      .then(() => {
        uni.showToast({ title: '修改成功', icon: 'success' })
        cancelEdit()
        load()
      })
      .catch(() => {
        uni.showToast({ title: '修改失败', icon: 'none' })
      })
    return
  }

  const makeDefault = addresses.value.length === 0
  createShopAddress(
    ZWEQ_ACCOUNT_ID,
    formName.value.trim(),
    mobile,
    formRegion.value.trim(),
    formDetail.value.trim(),
    makeDefault,
  )
    .then(() => {
      uni.showToast({ title: '保存成功', icon: 'success' })
      formName.value = ''
      formMobile.value = ''
      formRegion.value = ''
      formDetail.value = ''
      load()
    })
    .catch(() => {
      uni.showToast({ title: '保存失败', icon: 'none' })
    })
}
</script>
