<template>
  <view>
    <NavBar title="zweq" :show-back="false" />
    <view class="content-container pb-20px">
      <view class="mt-30px flex flex-col items-center">
        <text class="text-36px font-bold text-[#0957DE]">zweq 小程序</text>
        <text class="text-14px text-[#64748b] mt-8px">多商户微信运营平台 · 场景应用中心</text>
      </view>

      <!-- 粉丝状态 -->
      <view
        class="mx-30px mt-30px px-24rpx py-20rpx rounded-12px"
        style="background-color: rgba(9, 87, 222, 0.06);"
      >
        <view v-if="fanReady" class="flex flex-col">
          <view class="flex flex-row items-center justify-between">
            <text class="text-14px font-bold text-[#1e293b]">粉丝已连接</text>
            <text class="text-12px text-[#64748b]" style="font-family: monospace;">{{ maskedOpenid }}</text>
          </view>
          <view class="mt-12rpx flex flex-row items-center justify-between">
            <text class="text-14px text-[#0957DE] font-bold">积分 {{ fanPoints }}</text>
            <text v-if="pendingOrders > 0" class="text-12px text-[#f59e0b]" @click="goPendingOrders">待支付 {{ pendingOrders }} 单 ›</text>
          </view>
        </view>
        <view v-else class="flex flex-row items-center justify-between">
          <text class="text-14px text-[#64748b]">进入商城后将自动建立粉丝会话</text>
          <text class="text-12px text-[#0957DE]" @click="goShop('/src/pages/shop/products')">去逛逛 ›</text>
        </view>
      </view>

      <!-- 管理员状态（次要） -->
      <view
        v-if="adminLoggedIn"
        class="mx-30px mt-12rpx px-24rpx py-14rpx rounded-12px flex flex-row items-center justify-between"
        style="background-color: #f8fafc;"
        @click="goLogin"
      >
        <text class="text-12px text-[#64748b]">运营：{{ nickname }}</text>
        <text class="text-11px text-[#94a3b8]">已登录 ›</text>
      </view>

      <!-- AI 入口引导条 -->
      <view
        class="mx-30px mt-20rpx px-24rpx py-20rpx rounded-12px flex flex-row items-center justify-between"
        style="background-color: rgba(37, 99, 235, 0.08);"
        @click="goAi"
      >
        <text class="text-14px font-bold text-[#2563eb]">🤖 AI 智能助手</text>
        <text class="text-12px text-[#64748b]">答疑 · 运营建议 ›</text>
      </view>

      <!-- 商城快捷入口 -->
      <view class="mx-30px mt-20rpx px-24rpx py-20rpx rounded-12px" style="background-color: #f8fafc;">
        <text class="text-14px font-bold text-[#1e293b] mb-16rpx">商城</text>
        <view class="flex flex-row flex-wrap">
          <view class="w-200rpx mr-16rpx mb-12rpx px-16rpx py-16rpx rounded-8rpx" style="background-color: #ffffff;" @click="goShop('/src/pages/shop/products')">
            <text class="text-13px text-[#1e293b]">🛍️ 商品</text>
          </view>
          <view class="w-200rpx mr-16rpx mb-12rpx px-16rpx py-16rpx rounded-8rpx" style="background-color: #ffffff;" @click="goShop('/src/pages/shop/cart')">
            <text class="text-13px text-[#1e293b]">🛒 购物车</text>
          </view>
          <view class="w-200rpx mr-16rpx mb-12rpx px-16rpx py-16rpx rounded-8rpx" style="background-color: #ffffff;" @click="goShop('/src/pages/shop/orders?status=0')">
            <text class="text-13px text-[#1e293b]">📦 订单</text>
          </view>
          <view class="w-200rpx mr-16rpx mb-12rpx px-16rpx py-16rpx rounded-8rpx" style="background-color: #ffffff;" @click="goShop('/src/pages/shop/favorites')">
            <text class="text-13px text-[#1e293b]">❤️ 收藏</text>
          </view>
          <view class="w-200rpx mb-12rpx px-16rpx py-16rpx rounded-8rpx" style="background-color: #ffffff;" @click="goShop('/src/pages/shop/addresses')">
            <text class="text-13px text-[#1e293b]">📍 地址</text>
          </view>
        </view>
      </view>

      <!-- 场景应用网格 -->
      <view class="mt-30px mx-30px">
        <text class="text-16px font-bold text-[#1e293b]">微信场景应用</text>
        <text class="text-12px text-[#94a3b8] ml-8rpx">粉丝在公众号回复关键词即可互动</text>
        <view class="mt-16rpx flex flex-row flex-wrap justify-between">
          <view
            v-for="scene in scenes"
            :key="scene.key"
            class="w-320rpx mb-20rpx px-24rpx py-24rpx rounded-12px"
            style="background-color: #f8fafc;"
            @click="showScene(scene)"
          >
            <text class="text-16px font-bold text-[#1e293b]">{{ scene.emoji }} {{ scene.name }}</text>
            <view class="mt-8rpx">
              <text class="text-12px text-[#64748b]">{{ scene.tip }}</text>
            </view>
            <view class="mt-8rpx">
              <text v-if="scene.keyword !== ''" class="text-11px px-8rpx py-2rpx rounded-8rpx text-[#0957DE]" style="background-color: rgba(9,87,222,0.08);">
                回复「{{ scene.keyword }}」
              </text>
              <text v-else class="text-11px px-8rpx py-2rpx rounded-8rpx text-[#64748b]" style="background-color: #e2e8f0;">
                管理端查看
              </text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
/* eslint-disable dot-notation */
import { ref } from 'vue'
import { useTokenStore, useUserStore } from '../../store'
import { useShopSessionStore } from '../../store/shopSession'
import { getFanProfile } from '../../api/app'
import { getCachedShopOpenid } from '../../api/shop'
import { ensureShopSession } from '../../api/shopAuth'
import { getPendingOrderCount } from '../../utils/cartBadge'
import { maskOpenid } from '../../utils/format'
import { ZWEQ_ACCOUNT_ID } from '../../config/zweq'
import { setCurIdxByPath } from '../../tabbar/store'

const tokenStore = useTokenStore()
const userStore = useUserStore()
const shopSession = useShopSessionStore()

const adminLoggedIn = ref<boolean>(tokenStore.hasValidLogin())
const fanReady = ref<boolean>(false)
const fanPoints = ref<number>(0)
const pendingOrders = ref<number>(0)
const maskedOpenid = ref<string>('')
const nickname = ref<string>('')
const refreshing = ref<boolean>(false)

onShow(() => {
  adminLoggedIn.value = tokenStore.hasValidLogin()
  if (adminLoggedIn.value) {
    const info = userStore.getUserInfo()
    nickname.value = info.nickname.length > 0 ? info.nickname : info.username
  }
  refreshFanState()
})

onPullDownRefresh(() => {
  if (refreshing.value) {
    uni.stopPullDownRefresh()
    return
  }
  refreshing.value = true
  ensureShopSession(ZWEQ_ACCOUNT_ID)
    .then(() => {
      refreshFanState()
    })
    .catch(() => {
      refreshFanState()
    })
    .finally(() => {
      refreshing.value = false
      uni.stopPullDownRefresh()
    })
})

function refreshFanState() {
  const openid = getCachedShopOpenid(ZWEQ_ACCOUNT_ID)
  fanReady.value = shopSession.isValid(ZWEQ_ACCOUNT_ID) && openid.length > 0
  maskedOpenid.value = openid.length > 0 ? maskOpenid(openid) : ''
  if (!fanReady.value) {
    fanPoints.value = 0
    pendingOrders.value = 0
    return
  }
  getFanProfile(ZWEQ_ACCOUNT_ID)
    .then((profile) => {
      fanPoints.value = profile.points
    })
    .catch(() => {
      fanPoints.value = 0
    })
  getPendingOrderCount(ZWEQ_ACCOUNT_ID)
    .then((count: number) => {
      pendingOrders.value = count
    })
    .catch(() => {
      pendingOrders.value = 0
    })
}

function goPendingOrders() {
  uni.navigateTo({ url: '/src/pages/shop/orders?status=0' })
}

type IScene = {
  key: string
  emoji: string
  name: string
  tip: string
  keyword: string
}

const scenes: IScene[] = [
  { key: 'shop', emoji: '🛍️', name: '商城', tip: '商品 · 购物车 · 下单', keyword: '' },
  { key: 'checkin', emoji: '📅', name: '签到', tip: '每日签到领积分', keyword: '签到' },
  { key: 'luckyDraw', emoji: '🎰', name: '大转盘', tip: '积分抽奖赢好礼', keyword: '抽奖' },
  { key: 'coupon', emoji: '🎫', name: '优惠券', tip: '领券下单享折扣', keyword: '领券' },
  { key: 'vote', emoji: '🗳️', name: '投票', tip: '粉丝互动选题', keyword: '投票' },
  { key: 'seckill', emoji: '⚡', name: '秒杀', tip: '限时低价抢购', keyword: '秒杀' },
  { key: 'memberCard', emoji: '💳', name: '会员卡', tip: '积分等级与折扣', keyword: '办卡' },
  { key: 'distribution', emoji: '💰', name: '分销', tip: '三级返佣体系', keyword: '加盟' },
  { key: 'points', emoji: '🛒', name: '积分商城', tip: '积分兑换商品', keyword: '' },
]

function goLogin() {
  uni.navigateTo({ url: '/src/sub/auth/login' })
}

function goAi() {
  setCurIdxByPath('/src/pages/ai/ai')
  uni.switchTab({ url: '/src/pages/ai/ai' })
}

function goShop(url: string) {
  uni.navigateTo({ url })
}

function showScene(scene: IScene) {
  if (scene.key === 'shop') {
    uni.navigateTo({ url: '/src/pages/shop/products' })
    return
  }
  if (scene.key === 'points') {
    uni.navigateTo({ url: '/src/pages/scene/points' })
    return
  }
  if (scene.key === 'coupon') {
    uni.navigateTo({ url: '/src/pages/scene/coupons' })
    return
  }
  if (scene.key === 'luckyDraw') {
    uni.navigateTo({ url: '/src/pages/scene/lucky-draw' })
    return
  }
  if (scene.key === 'checkin') {
    uni.navigateTo({ url: '/src/pages/scene/checkin' })
    return
  }
  if (scene.key === 'vote') {
    uni.navigateTo({ url: '/src/pages/scene/vote' })
    return
  }
  if (scene.key === 'seckill') {
    uni.navigateTo({ url: '/src/pages/scene/seckill' })
    return
  }
  if (scene.key === 'memberCard') {
    uni.navigateTo({ url: '/src/pages/scene/member-card' })
    return
  }
  if (scene.key === 'distribution') {
    uni.navigateTo({ url: '/src/pages/scene/distribution' })
    return
  }
  uni.showModal({
    title: `${scene.emoji} ${scene.name}`,
    content: scene.keyword === ''
      ? `${scene.tip}，登录后可在管理端查看`
      : `${scene.tip}。粉丝在公众号回复「${scene.keyword}」，由消息接收器（Receiver）自动响应`,
    showCancel: false,
    confirmText: '知道了',
  })
}
</script>
