/** 加盟分销 */
export function joinAppDistribution(
  accountId: number = ZWEQ_ACCOUNT_ID,
  parentOpenid: string = '',
): Promise<void> {
  return withFanSession(accountId, () =>
    http.post<void>(
      '/api/v1/app/distribution/join',
      { account_id: accountId, parent_openid: parentOpenid },
      { extra: fanAuthExtra() },
    ),
  )
}

/** 佣金提现（金额单位：分） */
export function withdrawAppDistribution(
  accountId: number,
  amount: number,
): Promise<void> {
  return withFanSession(accountId, () =>
    http.post<void>(
      '/api/v1/app/distribution/withdraw',
      { account_id: accountId, amount },
      { extra: fanAuthExtra() },
    ),
  )
}
