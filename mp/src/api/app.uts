    return http.get<IPagedList<IAppCoupon>>(`/api/v1/app/coupons?${query}`, { extra: fanAuthExtra() })
  })
}

/** 领取优惠券 */
export function claimAppCoupon(accountId: number, couponId: number): Promise<IAppClaimResult> {
  return withFanSession(accountId, () =>
    http.post<IAppClaimResult>(
      `/api/v1/app/coupons/${couponId}/claim`,
      { account_id: accountId },
      { extra: fanAuthExtra() },
    ),
  )
}

