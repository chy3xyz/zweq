// ==========================================
// zweq C 端场景 BFF — 粉丝 JWT（fanAuthExtra）
// ==========================================

import { http } from '../http/request'
import { ZWEQ_ACCOUNT_ID } from '../config/zweq'
import { ensureShopSession, fanAuthExtra } from './shopAuth'
import type { IPagedList } from './points'

// ==========================================
// 类型定义
// ==========================================

export type IFanProfile = {
  openid: string
  nickname: string
  avatar: string
  points: number
}

export type IAppPointsProduct = {
  id: number
  account_id: number
  name: string
  points: number
  stock: number
}

export type IAppCoupon = {
  id: number
  account_id: number
  title: string
  amount: number
  min_amount: number
  total: number
  per_user: number
  start_at: number
  end_at: number
}

export type IAppMyCoupon = {
  id: number
  coupon_id: number
  code: string
  status: string
  created_at: number
}

export type IAppDrawRecord = {
  id: number
  prize_name: string
  points: number
  created_at: number
}

export type IAppDrawResult = {
  prize_name: string
  points: number
}

export type IAppDrawConfig = {
  cost: number
  daily_limit: number
  prize_count: number
}

export type IAppRedeemResult = {
  order_id: number
}

export type IAppClaimResult = {
  code: string
}

export type IAppCheckinRecord = {
  id: number
  day: number
  points: number
  created_at: number
}

export type IAppCheckinResult = {
  points: number
  fresh: boolean
}

export type IAppVote = {
  id: number
  account_id: number
  title: string
  options_json: string
  end_at: number
  created_at: number
}

export type IAppVoteDetail = {
  id: number
  title: string
  options_json: string
  end_at: number
  tally: number[]
}

export type IAppSeckillActivity = {
  id: number
  account_id: number
  title: string
  price: string
  original_price: string
  stock: number
  sold: number
  per_user: number
  start_at: number
  end_at: number
}

export type IAppSeckillRushResult = {
  order_id: number
}

export type IAppSeckillOrder = {
  id: number
  account_id: number
  openid: string
  activity_id: number
  quantity: number
  created_at: number
}

export type IAppMemberCard = {
  openid: string
  level_name: string
  level: number
  discount: number
  points: number
  total_points: number
}

export type IAppDistribution = {
  openid: string
  parent_openid: string
  commission_balance: number
  total_commission: number
}

export type IAppPointsOrder = {
  id: number
  product_id: number
  product_name: string
  points_spent: number
  status: string
}

// ==========================================
// 内部：写操作前确保粉丝会话
// ==========================================

async function withFanSession<T>(accountId: number, fn: () => Promise<T>): Promise<T> {
  await ensureShopSession(accountId)
  return fn()
}

// ==========================================
// API 函数
// ==========================================

/** 粉丝资料（含积分余额） */
export function getFanProfile(accountId: number = ZWEQ_ACCOUNT_ID): Promise<IFanProfile> {
  return withFanSession(accountId, () => {
    const query = `account_id=${accountId}`
    return http.get<IFanProfile>(`/api/v1/app/fan/profile?${query}`, { extra: fanAuthExtra() })
  })
}

/** 积分商城商品列表 */
export function listAppPointsProducts(
  accountId: number = ZWEQ_ACCOUNT_ID,
  page: number = 1,
  pageSize: number = 50,
): Promise<IPagedList<IAppPointsProduct>> {
  return withFanSession(accountId, () => {
    const query = `account_id=${accountId}&page=${page}&page_size=${pageSize}`
    return http.get<IPagedList<IAppPointsProduct>>(`/api/v1/app/points/products?${query}`, { extra: fanAuthExtra() })
  })
}

/** 积分兑换 */
export function redeemAppPoints(accountId: number, productId: number): Promise<IAppRedeemResult> {
  return withFanSession(accountId, () =>
    http.post<IAppRedeemResult>(
      '/api/v1/app/points/redeem',
      { account_id: accountId, product_id: productId },
      { extra: fanAuthExtra() },
    ),
  )
}

/** 我的积分兑换记录 */
export function listAppPointsOrders(accountId: number = ZWEQ_ACCOUNT_ID): Promise<IAppPointsOrder[]> {
  return withFanSession(accountId, () => {
    const query = `account_id=${accountId}`
    return http.get<IAppPointsOrder[]>(`/api/v1/app/points/orders?${query}`, { extra: fanAuthExtra() })
  })
}

