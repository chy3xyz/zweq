/** 获取支付参数（mock 或 wxpay_v3） */
export function getShopOrderPayParams(id: number): Promise<IShopOrderPayParams> {
  return withFanSession(ZWEQ_ACCOUNT_ID, () =>
    http.get<IShopOrderPayParams>(`/api/v1/shop/orders/${id}/pay-params`, { extra: fanAuthExtra() }),
  )
}

/** mock 支付完成（mode=mock 时） */
export function completeShopOrderPay(id: number): Promise<void> {
  return withFanSession(ZWEQ_ACCOUNT_ID, () =>
    http.post<void>(`/api/v1/shop/orders/${id}/pay-complete`, {}, { extra: fanAuthExtra() }),
  )
