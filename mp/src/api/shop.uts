/** 取消收藏 */
export function deleteShopFavorite(id: number): Promise<void> {
  return withFanSession(ZWEQ_ACCOUNT_ID, () =>
    http.delete<void>(`/api/v1/shop/favorites/${id}`, null, { extra: fanAuthExtra() }),
  )
}

/** 当前缓存的 openid（未登录返回空串） */
export function getCachedShopOpenid(accountId: number = ZWEQ_ACCOUNT_ID): string {
  return sessionOpenid(accountId)
}

/** 商品评价列表（公开） */
export function listShopComments(productId: number): Promise<IShopComment[]> {
  const query = `product_id=${productId}`
  return http.get<IShopComment[]>(`/api/v1/shop/comments?${query}`, {
    extra: { ignoreAuth: true } as UTSJSONObject,
  })
}

/** 提交订单商品评价（订单须已完成） */
export function createShopComment(
  accountId: number,
  orderProductId: number,
  productId: number,
  star: number,
  content: string,
): Promise<{ id: number }> {
  return withFanSession(accountId, (openid) =>
    http.post<{ id: number }>(
      '/api/v1/shop/comments',
      {
        account_id: accountId,
        order_product_id: orderProductId,
        product_id: productId,
        openid,
        star,
        content,
      },
      { extra: fanAuthExtra() },
    ),
  )
}

/** 申请退款（已支付/已发货可申请） */
export function applyShopRefund(accountId: number, orderId: number, reason: string): Promise<void> {
  return withFanSession(accountId, (openid) =>
    http.post<void>(
      '/api/v1/shop/refunds',
      {
        account_id: accountId,
        order_id: orderId,
        openid,
        reason,
      },
      { extra: fanAuthExtra() },
    ),
  )
}

/** 查询订单退款单（无则返回 null） */
export function getShopRefundByOrder(orderId: number): Promise<IShopRefund | null> {
  return withFanSession(ZWEQ_ACCOUNT_ID, (openid) => {
    const query = `order_id=${orderId}&openid=${openid}`
    return http.get<IShopRefund | null>(`/api/v1/shop/refunds?${query}`, { extra: fanAuthExtra() })
  })
}

/** 批量删除购物车项 */
export async function deleteShopCartItems(ids: number[]): Promise<void> {
  for (let i = 0; i < ids.length; i++) {
    try {
      await deleteShopCart(ids[i])
    } catch (_e) {
      // 忽略单项失败，继续清理
    }
  }
}
